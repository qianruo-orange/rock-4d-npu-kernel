+	/*
+	 * 解码器超频：aclk_jpeg_root 的 mux 支持 gpll/cpll/aupll/spll，
+	 * 默认 spll 702 MHz，改挂 cpll 取 1000 MHz（+42%）。
+	 */
+	assigned-clocks = <&cru ACLK_JPEG_ROOT>;
+	assigned-clock-rates = <1000000000>;
+};
+
+&jpeg_mmu {
+	status = "okay";
+};
+
+#include "rk3576-vepu510-mpp.dtsi"
+#include "rk3576-vdpu383-mpp.dtsi"
+#include "rk3576-rga2.dtsi"
+
+&rga2_core0 {
+	status = "okay";
+};
+
+&rga2_core0_mmu {
+	status = "okay";
+};
+
+&rga2_core1 {
+	status = "okay";
+};
+
+&rga2_core1_mmu {
+	status = "okay";
+};
diff --git a/arch/arm64/boot/dts/rockchip/rk3576-vdpu383-mpp.dtsi b/arch/arm64/boot/dts/rockchip/rk3576-vdpu383-mpp.dtsi
new file mode 100644
index 0000000..c6b9568
--- /dev/null
+++ b/arch/arm64/boot/dts/rockchip/rk3576-vdpu383-mpp.dtsi
@@ -0,0 +1,46 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR MIT)
+/* RK3576 VDPU383 using the MPP service with standard DMA-BUF mappings. */
+
+&vdec {
+	status = "disabled";
+};
+
+&vdec_mmu {
+	status = "okay";
+};
+
+&mpp_srv {
+	rockchip,taskqueue-count = <2>;
+	rockchip,resetgroup-count = <2>;
+};
+
+/ {
+	rkvdec_mpp: video-codec@27b00100 {
+		compatible = "rockchip,rkv-decoder-rk3576";
+		reg = <0x0 0x27b00100 0x0 0x600>,
+		      <0x0 0x27b00000 0x0 0x100>;
+		reg-names = "regs", "link";
+		interrupts = <GIC_SPI 308 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&cru ACLK_RKVDEC_ROOT>, <&cru HCLK_RKVDEC>,
+			 <&cru CLK_RKVDEC_CORE>, <&cru ACLK_RKVDEC_ROOT_BAK>,
+			 <&cru CLK_RKVDEC_HEVC_CA>;
+		clock-names = "aclk_vcodec", "hclk_vcodec", "clk_core",
+			      "clk_cabac", "clk_hevc_cabac";
+		assigned-clocks = <&cru ACLK_RKVDEC_ROOT>, <&cru CLK_RKVDEC_CORE>,
+				  <&cru ACLK_RKVDEC_ROOT_BAK>, <&cru CLK_RKVDEC_HEVC_CA>;
+		assigned-clock-rates = <600000000>, <600000000>,
+				       <500000000>, <1000000000>;
+		resets = <&cru SRST_A_RKVDEC_BIU>, <&cru SRST_H_RKVDEC_BIU>,
+			 <&cru SRST_H_RKVDEC>, <&cru SRST_RKVDEC_CORE>,
+			 <&cru SRST_RKVDEC_HEVC_CA>;
+		reset-names = "video_a", "video_h", "video_cabac",
+			      "video_core", "video_hevc_cabac";
+		iommus = <&vdec_mmu>;
+		power-domains = <&power RK3576_PD_VDEC>;
+		rockchip,srv = <&mpp_srv>;
+		rockchip,taskqueue-node = <1>;
+		rockchip,resetgroup-node = <1>;
+		rockchip,task-capacity = <1>;
+		rockchip,disable-auto-freq;
+	};
+};
diff --git a/arch/arm64/boot/dts/rockchip/rk3576-vepu510-mpp.dtsi b/arch/arm64/boot/dts/rockchip/rk3576-vepu510-mpp.dtsi
new file mode 100644
index 0000000..a53473d
--- /dev/null
+++ b/arch/arm64/boot/dts/rockchip/rk3576-vepu510-mpp.dtsi
@@ -0,0 +1,49 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR MIT)
+/* Experimental single-core MPP encoder integration for mainline RK3576. */
+
+#include <dt-bindings/clock/rockchip,rk3576-cru.h>
+#include <dt-bindings/interrupt-controller/arm-gic.h>
+#include <dt-bindings/power/rockchip,rk3576-power.h>
+#include <dt-bindings/reset/rockchip,rk3576-cru.h>
+
+/ {
+	mpp_srv: mpp-srv {
+		compatible = "rockchip,mpp-service";
+		rockchip,taskqueue-count = <1>;
+		rockchip,resetgroup-count = <1>;
+	};
+
+	rkvenc0: video-codec@27a00000 {
+		compatible = "rockchip,rkv-encoder-rk3576";
+		reg = <0x0 0x27a00000 0x0 0x6000>;
+		interrupts = <GIC_SPI 310 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "irq_vepu0";
+		clocks = <&cru ACLK_VEPU0>, <&cru HCLK_VEPU0>,
+			 <&cru CLK_VEPU0_CORE>;
+		clock-names = "aclk_vcodec", "hclk_vcodec", "clk_core";
+		/* Fixed bring-up clocks; vendor OPP/DVFS is not enabled. */
+		assigned-clocks = <&cru ACLK_VEPU0_ROOT>,
+				  <&cru HCLK_VEPU0_ROOT>, <&cru CLK_VEPU0_CORE>;
+		assigned-clock-rates = <500000000>, <100000000>, <594000000>;
+		resets = <&cru SRST_A_VEPU0>, <&cru SRST_H_VEPU0>,
+			 <&cru SRST_VEPU0_CORE>;
+		reset-names = "video_a", "video_h", "video_core";
+		iommus = <&rkvenc0_mmu>;
+		power-domains = <&power RK3576_PD_VEPU0>;
+		rockchip,srv = <&mpp_srv>;
+		rockchip,taskqueue-node = <0>;
+		rockchip,resetgroup-node = <0>;
+		rockchip,task-capacity = <8>;
+	};
+
+	rkvenc0_mmu: iommu@27a0f000 {
+		compatible = "rockchip,rk3576-iommu", "rockchip,rk3568-iommu";
+		reg = <0x0 0x27a0f000 0x0 0x40>;
+		interrupts = <GIC_SPI 311 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&cru ACLK_VEPU0>, <&cru HCLK_VEPU0>;
+		clock-names = "aclk", "iface";
+		#iommu-cells = <0>;
+		rockchip,disable-mmu-reset;
+		power-domains = <&power RK3576_PD_VEPU0>;
+	};
+};
