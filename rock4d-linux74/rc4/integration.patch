@@ -868,3 +869,50 @@
 		remote-endpoint = <&hdmi_in_vp0>;
 	};
 };
+
+&rknpu {
+	npu-supply = <&vdd_npu_s0>;
+	status = "okay";
+};
+
+&rknpu_mmu_0 {
+	status = "okay";
+};
+
