+/**
+ * rockchip_iommu_set_fault_handler() - Set a master's MMU fault notification
+ * @master: master attached to the Rockchip IOMMU
+ * @handler: atomic callback, or NULL to remove the notification
+ * @data: caller-owned callback context
+ *
+ * DMA domains own their IOVA cookies, so they cannot use the legacy domain
+ * fault-handler cookie. Keep notification separate from DMA mapping state.
+ * One master may register per IOMMU; a competing master receives -EBUSY.
+ * The callback runs with MMU clocks held and must not sleep or call this API.
+ * The caller must keep its master/context alive until removal completes.
+ * Removal waits for an in-progress callback through fault_lock.
+ *
+ * Return: zero on success, -ENODEV for an unknown master, or -EBUSY.
+ */
+int rockchip_iommu_set_fault_handler(struct device *master,
+				   rockchip_iommu_fault_handler_t handler, void *data)
+{
+	struct rk_iommu *iommu;
+	unsigned long flags;
+	int ret = 0;
+
+	if (!master)
+		return -ENODEV;
+	iommu = rk_iommu_from_dev(master);
+	if (!iommu)
+		return handler ? -ENODEV : 0;
+
+	spin_lock_irqsave(&iommu->fault_lock, flags);
+	if (iommu->fault_master && iommu->fault_master != master) {
+		ret = -EBUSY;
+	} else {
+		iommu->fault_master = handler ? master : NULL;
+		iommu->fault_handler = handler;
+		iommu->fault_data = handler ? data : NULL;
+	}
+	spin_unlock_irqrestore(&iommu->fault_lock, flags);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(rockchip_iommu_set_fault_handler);
+
 /* Must be called with iommu powered on and attached */
