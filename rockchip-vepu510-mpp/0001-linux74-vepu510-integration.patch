media: rockchip: support single-core VEPU510 MPP on Linux 7.4

Add powered-domain idle, checked IOMMU recovery and a master fault
notification that preserves DMA domain cookies. Connect the ROCK 4D
encoder and MMU with fixed bring-up clocks. AI-assisted port.

---
diff --git a/drivers/pmdomain/rockchip/pm-domains.c b/drivers/pmdomain/rockchip/pm-domains.c
--- a/drivers/pmdomain/rockchip/pm-domains.c
+++ b/drivers/pmdomain/rockchip/pm-domains.c
@@ -779,6 +779,72 @@
 	return ret;
 }
 
+/**
+ * rockchip_pmu_idle_request() - Request bus idle for a powered Rockchip domain
+ * @dev: device attached to exactly one Rockchip power domain
+ * @idle: true to request idle, false to release the request
+ *
+ * The caller must stop all masters in the domain and keep runtime PM references
+ * and the engine clocks held across the complete idle/reset/unidle sequence.
+ * The device must remain attached to its domain throughout that sequence.
+ * This function may sleep and must not be called from a PM domain callback.
+ * It neither powers the domain nor resets hardware. A successful idle request
+ * remains asserted until the caller explicitly releases it. A failed idle
+ * handshake may also leave the request asserted; the caller must try to release
+ * it before unwinding its runtime PM and clock references.
+ *
+ * Return: zero on success, or a negative error if the domain is unsupported,
+ * powered off, its clocks cannot be enabled, or the idle handshake times out.
+ */
+int rockchip_pmu_idle_request(struct device *dev, bool idle)
+{
+	struct generic_pm_domain *genpd;
+	struct rockchip_pm_domain *pd;
+	struct rockchip_pmu *pmu;
+	int ret;
+
+	if (IS_ERR_OR_NULL(dev) || IS_ERR_OR_NULL(dev->pm_domain))
+		return -ENODEV;
+
+	if (!dev->of_node ||
+	    of_count_phandle_with_args(dev->of_node, "power-domains",
+				      "#power-domain-cells") != 1)
+		return -EOPNOTSUPP;
+
+	/* This also validates that pm_domain really belongs to the genpd core. */
+	if (!dev_pm_genpd_is_on(dev))
+		return -EHOSTDOWN;
+
+	genpd = pd_to_genpd(dev->pm_domain);
+	if (genpd->power_on != rockchip_pd_power_on)
+		return -EOPNOTSUPP;
+
+	pd = to_rockchip_pd(genpd);
+	if (!pd->info->req_mask)
+		return -EOPNOTSUPP;
+	pmu = pd->pmu;
+
+	guard(mutex)(&pmu->mutex);
+
+	/* Idle-only domains have no independent power-status bit to recheck. */
+	if ((pd->info->status_mask || pd->info->repair_status_mask) &&
+	    !rockchip_pmu_domain_is_on(pd))
+		return -EHOSTDOWN;
+
+	/* These clocks were prepared when the domain was registered. */
+	ret = clk_bulk_enable(pd->num_clks, pd->clks);
+	if (ret)
+		return ret;
+
+	rockchip_pmu_ungate_clk(pd, true);
+	ret = rockchip_pmu_set_idle_request(pd, idle);
+	rockchip_pmu_ungate_clk(pd, false);
+	clk_bulk_disable(pd->num_clks, pd->clks);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(rockchip_pmu_idle_request);
+
 static int rockchip_pd_attach_dev(struct generic_pm_domain *genpd,
 				  struct device *dev)
 {
